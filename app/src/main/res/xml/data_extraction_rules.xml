<?xml version="1.0" encoding="utf-8"?>
<!-- Android's automatic backup (Android 12 and newer): the same as backup_rules.xml. Playlists, favorites,
     play counts and settings go to the user's Google backup and to a new phone; caches never do. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <!-- Tied to this phone: folder permission and home-screen widget IDs don't carry over -->
        <exclude domain="sharedpref" path="lyrics_folder.xml" />
        <exclude domain="sharedpref" path="player_widget.xml" />
        <exclude domain="sharedpref" path="playlist_widget.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <!-- Tied to this phone: folder permission and home-screen widget IDs don't carry over -->
        <exclude domain="sharedpref" path="lyrics_folder.xml" />
        <exclude domain="sharedpref" path="player_widget.xml" />
        <exclude domain="sharedpref" path="playlist_widget.xml" />
    </device-transfer>
</data-extraction-rules>
