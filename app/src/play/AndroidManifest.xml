<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play version: no internet, no self-update (Play updates it) and no song downloads -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nothing in this version goes online: no YouTube, no online lyrics, no update checks -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <application>
        <service android:name=".service.SongDownloadService" tools:node="remove" />
        <provider android:name="androidx.core.content.FileProvider" tools:node="remove" />
        <receiver android:name=".receiver.UpdateBroadcastReceiver" tools:node="remove" />
    </application>
</manifest>
